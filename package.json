{
  "name": "main-site",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "echo 'Building Sanity to public/studio' && npm i --prefix studio && dotenv -e .env.sanity.build -- npm run build --prefix studio -- ../public/studio -y && echo 'Done'",
    "build": "next build",
    "sanity": "dotenv -e .env.local npm run start -- --prefix studio",
    "sanity:edit": "dotenv -e .env.local npm run edit -- --prefix studio",
    "sanity:list:pages": "dotenv -e .env.local npm run list:pages -- --prefix studio",
    "deploy-dk-dataset": "node scripts/deploy-dk-dataset.js",
    "start": "next start",
    "lint": "eslint .",
    "cypress:no": "cross-env CYPRESS_PATH=node_modules/.bin/cypress cypress open --config-file cypress-no.config.ts",
    "cypress:no:headless": "cross-env CYPRESS_PATH=node_modules/.bin/cypress cypress run --config-file cypress-no.config.ts",
    "cypress:se": "cross-env CYPRESS_PATH=node_modules/.bin/cypress cypress open --config-file cypress-se.config.ts",
    "cypress:se:headless": "cross-env CYPRESS_PATH=node_modules/.bin/cypress cypress run --config-file cypress-se.config.ts -q",
    "cypress:dk": "cross-env CYPRESS_PATH=node_modules/.bin/cypress cypress open --config-file cypress-dk.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write \"./**/*{js,ts,jsx,tsx,json,md,css,scss,yml}\"",
    "prepare": "husky install",
    "analyze": "next experimental-analyze",
    "generate:wealthmountain": "npx tsx components/main/blocks/WealthCalculator/data/processInput.ts"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.10.0",
    "@babel/preset-typescript": "^7.29.7",
    "@observablehq/plot": "^0.6.17",
    "@portabletext/react": "^8.0.1",
    "@redux-devtools/extension": "^3.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@sanity/client": "^7.27.0",
    "@sanity/image-url": "^1.2.0",
    "@sanity/preview-kit": "^6.2.0",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/react-loader": "^2.2.2",
    "@sanity/visual-editing": "^5.7.3",
    "@ssfbank/norwegian-id-validators": "^1.0.0",
    "@stdlib/stats-base-dists-truncated-normal": "^0.2.3",
    "@vercel/kv": "^3.0.0",
    "babel-jest": "^29.7.0",
    "cookies-next": "^4.3.0",
    "d3": "^7.9.0",
    "html-react-parser": "^6.1.8",
    "jwt-decode": "^3.1.2",
    "katex": "^0.16.47",
    "luxon": "^3.7.2",
    "next": "^16.3.8",
    "next-plausible": "^3.12.5",
    "next-sanity": "^12.4.5",
    "next-seo": "^5.15.0",
    "organisationsnummer": "^1.2.0",
    "personnummer": "^3.2.1",
    "react": "^19.3.0",
    "react-animate-height": "^3.2.4",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.3.0",
    "react-draggable": "^4.7.2",
    "react-feather": "^2.0.10",
    "react-hook-form": "^7.89.0",
    "react-hook-inview": "^4.5.1",
    "react-number-format": "^5.4.5",
    "react-redux": "^9.3.0",
    "react-toastify": "^11.1.0",
    "react-youtube": "^10.1.0",
    "redux-saga": "^1.5.1",
    "sanity-image": "^1.3.0",
    "sass": "^1.105.1",
    "sass-loader": "^14.2.1",
    "styled-components": "^6.5.3",
    "swr": "^2.5.1",
    "textures": "^1.2.3",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/d3": "^7.4.3",
    "@types/d3-path": "^3.1.1",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.7.6",
    "@types/node": "18.15.11",
    "@types/react": "^19.3.0",
    "@types/styled-components": "^5.1.36",
    "babel-loader": "^8.4.1",
    "cross-env": "^7.0.3",
    "csv-parse": "^5.6.0",
    "cypress": "^15.21.1",
    "cypress-dotenv": "^2.0.2",
    "cypress-fail-fast": "^7.1.1",
    "cypress-localstorage-commands": "^1.7.0",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^13.3.0",
    "prettier": "2.8.1",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3",
    "typescript-fsa": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,md,css,scss,yml}": "prettier --write"
  },
  "overrides": {
    "@types/react": "^19.3.0"
  }
}
