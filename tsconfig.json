{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    // studio/sanity.types.ts augments @sanity/client; resolve it to the app's copy, not the
    // studio's own install, which the app typecheck can't see
    "paths": { "@sanity/client": ["./node_modules/@sanity/client"] }
  },
  "include": [
    "next-env.d.ts",
    "additional.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "studio/node_modules/@sanity/base/types/**/*.ts",
    "studio/components/pointlistPeview.jsx",
    "studio/resolveProductionUrl.ts",
    "proxy.page.ts"
  ],
  "exclude": ["node_modules", "studio", "cypress", "cypress-*.config.ts"]
}
